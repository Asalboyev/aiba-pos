# AIBA POS — standalone (local) env example.
# Inside cloud-os these are supplied by docker-compose.yml; this file is for
# running the service on its own (uvicorn main:app) during development.

APP_NAME=AIBA POS
ENVIRONMENT=development
TIMEZONE=Asia/Tashkent

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aiba_pos
POSTGRES_PASSWORD=aiba_pos_pass
POSTGRES_DB=aiba_pos

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth
JWT_SECRET_KEY=dev-pos-jwt-secret-change-me
# Shared with cloud-os (Nextcloud → pos). Must match AIBA_SERVICE_SECRET there.
AIBA_SERVICE_SECRET=dev-service-secret

# Fiscal / virtual cash register
# Providers: mock | multikassa | epos
FISCAL_PROVIDER=mock
FISCAL_API_URL=
FISCAL_API_TOKEN=
FISCAL_VERIFY_BASE=https://ofd.soliq.uz/epi/check

# E-POS Communicator (Universal Communicator 3.23.6+) — used when FISCAL_PROVIDER=epos
# Prod: http://localhost:8347/uzpos      (cashier PC with E-POS Communicator installed)
# Test: http://integration.epos.uz:8347/uzpos
EPOS_API_URL=http://integration.epos.uz:8347/uzpos
EPOS_TOKEN=
EPOS_PORT=3448
