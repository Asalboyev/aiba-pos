APP_NAME=AIBA POS
ENVIRONMENT=development
TIMEZONE=Asia/Tashkent

# Database (containers use the pos-db hostname automatically via compose overrides).
POSTGRES_DB=aiba_pos
POSTGRES_USER=aiba_pos
POSTGRES_PASSWORD=aiba_pos_pass
POSTGRES_HOST=pos-db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://pos-redis:6379/0
CELERY_BROKER_URL=redis://pos-redis:6379/1
CELERY_RESULT_BACKEND=redis://pos-redis:6379/1

# Auth
JWT_SECRET_KEY=dev-pos-jwt-secret-change-me
AIBA_SERVICE_SECRET=dev-service-secret
POS_ADMIN_USER=admin
POS_ADMIN_PASSWORD=aiba2026

# Fiscal (mock provider — works with no credentials)
# Providers: mock | multikassa | epos
FISCAL_PROVIDER=epos
FISCAL_API_URL=
FISCAL_API_TOKEN=
FISCAL_VERIFY_BASE=https://ofd.soliq.uz/epi/check
FISCAL_MAX_RETRIES=12

# E-POS Communicator (Universal Communicator 3.23.6+)
# Prod (kassa PC): http://localhost:8347/uzpos
# Test:            http://integration.epos.uz:8347/uzpos
EPOS_API_URL=http://integration.epos.uz:8347/uzpos
EPOS_TOKEN=DXJFX32CN1296678504F2
EPOS_PORT=3448

# Host port overrides — 8005/5433/6380 already used by other projects on this Mac.
POS_HOST_PORT=8006
POSTGRES_HOST_PORT=5436
REDIS_HOST_PORT=6382
